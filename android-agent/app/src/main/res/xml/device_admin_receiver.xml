<?xml version="1.0" encoding="utf-8"?>
<!--
  Politicas que o app pode aplicar como Device Owner. Deliberadamente
  minimo: reset de senha via token, bloqueio de tela remoto e, desde
  19/10/2026, apagar dados (wipe-data) - este ultimo so e disparado por
  comando explicito do TI, com confirmacao no painel (ver
  DeviceCommandExecutor). Nada alem disso foi desenhado nas telas do produto.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <reset-password />
        <force-lock />
        <wipe-data />
        <watch-login />
    </uses-policies>
</device-admin>
