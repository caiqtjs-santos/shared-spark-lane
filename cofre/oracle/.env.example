# Copie para .env e preencha. O .env NUNCA vai pro git.
# Domínio que aponta pro IP público do VM (ex: cofre.seudominio.com).
DOMINIO=cofre.seudominio.com
# 1) Escolha uma senha longa de admin e GUARDE (é ela que se digita em /admin
#    e que vai no segredo COFRE_ADMIN_TOKEN do app).
# 2) Gere o hash dela:  docker run --rm -it vaultwarden/server /vaultwarden hash
# 3) Cole o hash ENTRE ASPAS SIMPLES: ele tem "$" e, sem aspas, o docker compose
#    corta o valor e o login de admin nunca funciona.
VW_ADMIN_TOKEN='COLE_O_HASH_AQUI'
# true só até cadastrar o time; depois false e suba de novo.
VW_SIGNUPS_ALLOWED=true
