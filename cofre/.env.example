# Copie para .env e preencha. O .env NUNCA vai pro git (está no .gitignore).

# ---- Domínio (Fase 0) ----
DOMINIO_COFRE=cofre.seudominio.com
DOMINIO_MESH=mesh.seudominio.com

# ---- Vaultwarden (Fase 1) ----
# Gere com: docker run --rm -it vaultwarden/server /vaultwarden hash
# Cole o hash ENTRE ASPAS SIMPLES (ele tem "$" e o docker compose corta sem aspas).
VW_ADMIN_TOKEN='COLE_O_HASH_AQUI'
# true só até cadastrar o time; depois mude para false e suba de novo
VW_SIGNUPS_ALLOWED=true

# ---- RustDesk (Fase 2) ----
# Preenchido depois que o rustdesk-server subir e gerar as chaves
RUSTDESK_RELAY=seudominio.com
